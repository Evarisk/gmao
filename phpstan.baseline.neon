			identifier: assign.propertyType
			count: 1
			path: class/actions_gmao.class.php

		-
			message: '#^Class DoliDB referenced with incorrect case\: DoliDb\.$#'
			identifier: class.nameCase
			count: 1
			path: class/gmaodocuments/gmaoticketdocument.class.php

		-
			message: '#^Method GMAOTicketDocument\:\:createQRCode\(\) has no return type specified\.$#'
			identifier: missingType.return
