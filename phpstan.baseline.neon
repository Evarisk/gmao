parameters:
	ignoreErrors:
		-
			message: '#^Variable \$form might not be defined\.$#'
			identifier: variable.undefined
			count: 2
			path: admin/setup.php

		-
			message: '#^Method ActionsGmao\:\:addMoreActionsButtons\(\) has parameter \$action with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: class/actions_gmao.class.php

		-
			message: '#^Method ActionsGmao\:\:formObjectOptions\(\) has parameter \$action with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: class/actions_gmao.class.php

		-
			message: '#^Method ActionsGmao\:\:formObjectOptions\(\) has parameter \$object with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: class/actions_gmao.class.php

		-
			message: '#^Property InventoryLine\:\:\$fk_product \(int\) does not accept string\|null\.$#'
			identifier: assign.propertyType
			count: 1
			path: class/actions_gmao.class.php

		-
			message: '#^Property InventoryLine\:\:\$fk_warehouse \(int\) does not accept string\|null\.$#'
			identifier: assign.propertyType
